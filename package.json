{
  "name": "petpulse-ai",
  "private": true,
  "version": "2.0.0",
  "description": "PetPulse AI —— 全齡犬貓疼痛視覺初篩與健康生態微服務",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && tsc -p tsconfig.worker.json --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply petpulse-ai-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply petpulse-ai-db --remote",
    "sloplint": "node scripts/sloplint.mjs src --genre modern-minimal --scope app",
    "sloplint:render": "node scripts/sloplint.mjs src --genre modern-minimal --scope app --render"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.475.0",
    "onnxruntime-web": "^1.20.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^24.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "wrangler": "^4.169.0"
  }
}
