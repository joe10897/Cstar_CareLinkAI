# PetPulse AI — Cloudflare Workers Full-Stack Environment Template
# Copy to `.dev.vars` (gitignored) for local `npx wrangler dev`, or set via `npx wrangler secret put <KEY>`

# Cloudflare Worker Secrets (DO NOT commit real values)
SESSION_SECRET=replace-with-random-64-char-hex
ADMIN_EMAIL=admin@petpulse.ai
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_INVITE_CODE=replace-with-secret-admin-invite-code

# Optional: Upgrade Vision AI / OCR / Chat Triage primary engine to Gemini 2.5 Flash
# When omitted, PetPulse AI automatically uses Cloudflare Workers AI (Llama 4 Scout / Mistral Small 3.1 Vision)
GEMINI_API_KEY=

# Optional: Custom ONNX model URLs for on-device WebGPU inference
VITE_ONNX_DETECTOR_MODEL_URL=
VITE_ONNX_LANDMARK_MODEL_URL=
